  "question": "What would you need to understand before the numbers made sense?",
  "sections": [
    {
      "heading": "Start with the business",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "This example note is a reading exercise, not an analysis of a particular company. Its purpose is to organise questions before drawing a conclusion."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Begin by describing what a business sells, who pays for it, and what has to happen for that relationship to continue. A simple explanation exposes the gaps that a spreadsheet can sometimes conceal."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
