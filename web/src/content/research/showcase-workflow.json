{
  "id": "qa-workflow",
  "slug": "showcase-workflow",
  "title": "From draft to conversation",
  "summary": "A repeatable checklist for profile editing, contact links, research saves, sheets and responsive navigation.",
  "category": "Showcase",
  "tags": [
    "showcase",
    "testing"
  ],
  "publishedAt": "2026-09-28",
  "updatedAt": "2026-09-28",
  "status": "sample",
  "theme": "clay",
  "cover": {
    "word": "Review",
    "color": "#eee0ce",
    "variation": 0,
    "type": "theme",
    "preset": "clay"
  },
  "question": "Does the whole journey work from editing a note to contacting its author?",
  "sections": [
    {
      "heading": "Profile and contact",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit the name and monogram; one, two and three characters fit without clipping."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit “The person behind the notes”: heading, accent, biography and principles."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit Contact: heading, introduction, email, link label and subject."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reorder, add or remove contact links, then save and reload."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The email link opens a draft in your email app addressed to the saved profile email. Sending happens in that app."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "An invalid email should prevent saving and explain the issue."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Research editing",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "On a fresh admin load, wait for the fields to become available; the very first title edit must remain saved."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Create a draft with a title, summary, category, tags, question and sections."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Change the slug, dates, section order and cover; save, reload and preview."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reset unsaved changes and confirm the saved content returns."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit the same note in two tabs; a stale save should ask you to reload."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check required fields and duplicate slugs before publishing. Citations are optional for published notes and production releases; any supplied links must be valid HTTPS addresses."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Remove a temporary test note; its saved file should move to trash. Keep these three showcase notes."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Sheets and sources",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Upload an example Excel workbook, open each sheet and inspect formulas and values."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Download the workbook and confirm the filename and contents."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Add a shared Google Sheets link, edit its label, open it and remove it."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Publish a note without citations; Further reading stays hidden. Add an HTTPS source and check that the section and link appear."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Missing or invalid attachments should show errors without losing the note."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Release and recovery",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Review the Release checklist in Admin: profile approval, published research and the production HTTPS address are separate blockers."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Run npm run release:check from web/. It reports every blocker without approving or publishing content."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Citations remain optional. Samples, including these three notes, stay out of production."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Stop the local admin, then run npm run content:backup. Private images, workbooks, content, public files and local trash are included with checksums."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Run npm run content:restore -- BACKUP NEW-FOLDER. Restoration requires a new destination and checks every file before writing."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Compare restored profile, research, original images and workbooks; do not overwrite live content until you have reviewed the recovery."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Corrupted backups, unsafe paths and existing restore folders must be refused. Keep an off-device backup and review a release before deploying."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Legacy paragraphs and reflection points",
      "paragraphs": [
        "This section intentionally uses the original plain-paragraph format. Older research still reads correctly alongside rich sections."
      ],
      "prompts": [
        "Do reflection bullets display their markers?",
        "Does the section remain reachable from the contents links?"
      ]
    },
    {
      "heading": "Reading and navigation",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check the home carousel arrows, swiping and every direct research link."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check widths of 320, 390, 768, 1024 and 1440 pixels for overflow."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use the contents links, next-note link and Back to top repeatedly."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Read with the keyboard, reduced motion and JavaScript disabled."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check unknown URLs return a 404 and the static export has no admin pages."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Sample and draft notes stay out of production builds. These notes remain samples."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Latest change",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Local release readiness checks and verified content backup/restore. Deployment remains pending; all existing notes remain samples."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "These three sample notes are refreshed after each change request. Use the checks below to try the current features."
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "sources": [],
  "attachments": []
}
