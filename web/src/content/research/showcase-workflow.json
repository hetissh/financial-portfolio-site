{
  "id": "qa-workflow",
  "slug": "showcase-workflow",
  "title": "From draft to conversation",
  "summary": "A repeatable checklist for profile editing, contact links, research saves, sheets and responsive navigation.",
  "category": "Showcase",
  "tags": [
    "showcase",
    "testing"
  ],
  "publishedAt": "2026-09-28",
  "updatedAt": "2026-09-28",
  "status": "sample",
  "theme": "clay",
  "cover": {
    "word": "Review",
    "color": "#eee0ce",
    "variation": 0,
    "type": "theme",
    "preset": "clay"
  },
  "question": "Does the whole journey work from editing a note to contacting its author?",
  "sections": [
    {
      "heading": "Profile and contact",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit the name and monogram; one, two and three characters fit without clipping."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit “The person behind the notes”: heading, accent, biography and principles."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit Contact: heading, introduction, email, link label and subject."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reorder, add or remove contact links, then save and reload."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The email link opens a draft in your email app addressed to the saved profile email. Sending happens in that app."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "An invalid email should prevent saving and explain the issue."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Research editing",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The top admin navigation contains Overview, Profile and View site. Create a note using New research note in Overview."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Clear Tags to see Separate with commas. inside the input; there is no duplicate hint underneath. Tags remain editable and save as separate values."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "On a fresh admin load, wait for the fields to become available; the very first title edit must remain saved."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Create a draft with a title, summary, category, tags, question and sections."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Change the slug, dates, section order and cover; save, reload and preview."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reset unsaved changes and confirm the saved content returns."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Edit the same note in two tabs; a stale save should ask you to reload."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check required fields and duplicate slugs before publishing. Citations are optional for published notes and production releases; any supplied links must be valid HTTPS addresses."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Remove a temporary test note; its saved file should move to trash. Keep these three showcase notes."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Hosted workbook viewers",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "In Sheets & models, paste a published Google Sheets embed URL or its iframe code. Preview before attaching and saving."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "For Excel, paste the generated OneDrive or SharePoint embed link. You can attach it directly or add it to an uploaded workbook."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The note displays the provider’s spreadsheet inline with Open original, Reload and Expand controls. Pasted HTML must never execute in the site."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Select another sheet inside the viewer, expand it, close it and confirm the selected view remains. The close button is always available; Escape closes when focus is on a viewer control outside the iframe."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "On mobile, the page should fit the screen while the spreadsheet scrolls within its own frame. Large views must close and return focus to Expand."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Save, reload, preview, rename, reset and remove attachments. Reject invalid provider hosts, unrelated links and unsafe URLs without losing the note."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "An uploaded Excel file without a hosted embed retains its local sheet preview, formula display and original download. Clearing its embed link restores that preview."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Published Google Sheets are read-only and do not show formulas. Access is controlled by the provider; if a viewer is blank or requests sign-in, Open original remains available."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Test visitor access to the real hosted link in a private browser before release. Keep these notes as samples; no fake embed links are attached to them."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Sheets and sources",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Upload an example Excel workbook, open each sheet and inspect formulas and values."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Download the workbook and confirm the filename and contents."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Add a shared Google Sheets link, edit its label, open it and remove it."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Publish a note without citations; Further reading stays hidden. Add an HTTPS source and check that the section and link appear."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Missing or invalid attachments should show errors without losing the note."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Arrange the notebook",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use Show on home page in Publishing to select cards for the home rail; Overview arranges the selected cards too."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "In Admin Overview, drag a handle to move a research card. Dragging also works with touch; the page can scroll normally away from the handles."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use Move up or Move down, or focus a handle and press an arrow key. Home and End move to the first and last positions."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Press Escape or cancel a touch gesture during dragging; the previous arrangement should return."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Save order, reload and check the notebook, home cards and saved article previews. Automatic numbers follow the visible notebook order."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reset order discards an unsaved arrangement. Leaving with unsaved changes should ask before discarding it."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Try two admin tabs. A stale order save should ask you to reload; research text, status and selected-home membership should stay intact."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A failed save keeps your arrangement so you can retry. Deleting a note and adding another must not hide remaining cards."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Sand & Copper admin",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Overview, Profile and New note share sand backgrounds, cream panels, copper actions and a dark brown admin navigation bar."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Active navigation, keyboard focus, checked controls and crop dialogs remain clear on desktop and mobile."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Successful saves and published badges remain green; invalid fields and failed saves remain red."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Profile headline, card and saved article previews retain the public portfolio colours."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Choose View site, then return to admin: the public page keeps its original green palette."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Release and recovery",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "orderedList",
              "attrs": {
                "start": 1,
                "type": "1"
              },
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Review the Release checklist in Admin: profile approval, published research and the production HTTPS address are separate blockers."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Run npm run release:check from web/. It reports every blocker without approving or publishing content."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Citations remain optional. Samples, including these three notes, stay out of production."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Stop the local admin, then run npm run content:backup. Private images, workbooks, content, public files and local trash are included with checksums."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Run npm run content:restore -- BACKUP NEW-FOLDER. Restoration requires a new destination and checks every file before writing."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Compare restored profile, research, original images and workbooks; do not overwrite live content until you have reviewed the recovery."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Corrupted backups, unsafe paths and existing restore folders must be refused. Keep an off-device backup and review a release before deploying."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Legacy paragraphs and reflection points",
      "paragraphs": [
        "This section intentionally uses the original plain-paragraph format. Older research still reads correctly alongside rich sections."
      ],
      "prompts": [
        "Do reflection bullets display their markers?",
        "Does the section remain reachable from the contents links?"
      ]
    },
    {
      "heading": "Reading and navigation",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Reload an existing research editor, New note and Profile with an extension that adds body attributes. Fields should remain editable without a hydration warning; genuine mismatches inside the page should remain visible."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check the home carousel arrows, swiping and every direct research link."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check widths of 320, 390, 768, 1024 and 1440 pixels for overflow."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Use the contents links, next-note link and Back to top repeatedly."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Read with the keyboard, reduced motion and JavaScript disabled."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Check unknown URLs return a 404 and the static export has no admin pages."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Sample and draft notes stay out of production builds. These notes remain samples."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "heading": "Latest change",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Prevent extension-added body attributes from triggering hydration warnings while keeping admin editing responsive."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "These three sample notes are refreshed after each change request. Use the checks below to try the current features."
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "sources": [],
  "attachments": []
}
