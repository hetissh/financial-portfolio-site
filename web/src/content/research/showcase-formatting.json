      "heading": "Words and emphasis",
      "paragraphs": [],
      "body": {
        "version": 1,
        "doc": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A clear opening. ",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "A useful qualification. ",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Both together.",
                  "marks": [
                    {
                      "type": "bold"
                    },
                    {
                      "type": "italic"
                    }
                  ]
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "A useful subheading"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Use short paragraphs to separate the observation from the question."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 4
              },
              "content": [
                {
                  "type": "text",
                  "text": "A smaller heading"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A soft line break stays in the same paragraph."
                },
                {
                  "type": "hardBreak"
                },
                {
                  "type": "text",
                  "text": "Outside a list, press Shift+Enter to add one."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A worded point: ",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "Lead with a short label, then explain the idea."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Read the example source",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://example.com/"
                      }
                    }
                  ]
                }
              ]
            }
