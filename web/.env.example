# Local builds default to a non-indexable preview with example notes.
SITE_MODE=preview
# Copy this file to .env.local; keep real values only in that Git-ignored file
# or in the host's environment. Never use NEXT_PUBLIC_ for admin secrets.
# Set a real HTTPS origin for approved production content.
# SITE_URL=https://your-domain.com
# Cloud mode serves the public site and admin from one server. Enable only after
# migrations, content import, Auth binding, and deployment verification.
# PORTFOLIO_DATA_SOURCE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# The build exposes this project URL for public Storage links; it is not a secret.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# Admin mode requires two bootstrapped accounts in a private, writable JSON file.
# This file stores password hashes and session/token hashes, not plaintext passwords.
# PORTFOLIO_AUTH_FILE=/absolute/private/path/auth.json
# ADMIN_ORIGIN=https://your-domain.com
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=Portfolio <admin@your-domain.com>
# Unsplash image search in the research cover picker; create an API application at unsplash.com/developers.
# Keep this server-only key in web/.env.local and never prefix it with NEXT_PUBLIC_.
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Supply the following only for the one-time admin:bootstrap command, then remove
# the initial passwords from .env.local. Later changes use Admin management/reset.
# ADMIN_ONE_EMAIL=first@example.com
# ADMIN_ONE_PASSWORD=choose-a-private-initial-password
# ADMIN_TWO_EMAIL=second@example.com
# ADMIN_TWO_PASSWORD=choose-a-different-private-initial-password
